        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615"
                TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>потому что там можно / гулять / спокойно</ANNOTATION_VALUE>
